# Copy to .env.local for local dev. In production (Vercel) add these under
# Project → Settings → Environment Variables.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Safe for the browser (protected by Row Level Security)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SERVER ONLY — full database access. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Only needed if you later add Supabase Auth and verify JWTs yourself
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# Protects GET /api/bookings. Generate with: openssl rand -hex 24
ADMIN_API_TOKEN=

# Optional: also mirror bookings/enquiries into MongoDB
# MONGO_URL=
# DB_NAME=sarojani_funland
